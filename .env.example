# Copy to .env.local and fill in real values. Never commit .env.local.
SESSION_SECRET=

# Optional: Vercel Blob Storage read/write token. When set, uploads are stored
# in Vercel Blob (persistent, survives cold starts) instead of the local
# data/uploads dir / /tmp demo mode. Create a token in the Vercel dashboard
# (Storage -> Blob) and set this as an env var there.
BLOB_READ_WRITE_TOKEN=